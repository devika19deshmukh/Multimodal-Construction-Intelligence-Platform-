# Construction Intelligence Platform Environment Configuration

# Multimodal AI Keys (Optional: Leave empty to use high-fidelity domain simulator)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
GEMINI_MODEL=gemini-1.5-pro
OPENAI_MODEL=gpt-4o

# Provider Selection: "auto", "gemini", "openai", "mock"
AI_PROVIDER=auto

# Server Configuration
HOST=0.0.0.0
PORT=8000
